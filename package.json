{
  "name": "open-replay-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "chain:create": "node scripts/synthetic-chain.mjs create",
    "chain:start": "node scripts/synthetic-chain.mjs start",
    "chain:stop": "node scripts/synthetic-chain.mjs stop",
    "chain:status": "node scripts/synthetic-chain.mjs status",
    "chain:live": "node scripts/synthetic-chain.mjs live",
    "chain:delete": "node scripts/synthetic-chain.mjs delete",
    "demo:up": "node scripts/demo-up.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "ws": "^8.23.0"
  }
}
