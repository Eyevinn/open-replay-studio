# WHEP endpoint of the multiview stream (from Strom). Leave empty to use the built-in demo source.
OPEN_REPLAY_MULTIVIEW_WHEP_URL=

# Replay control over Strom's replay WebSocket. Set the Strom URL and the replay group of the flow's
# media players and the Studio finds the flow itself; leave both empty for the mock controller.
OPEN_REPLAY_STROM_URL=
OPEN_REPLAY_REPLAY_GROUP=
# Or give the WebSocket URL of one flow directly (/api/replay/<flow_id>/<group>/ws).
OPEN_REPLAY_REPLAY_WS_URL=

# Latency panel: the program outputs of an Open Live production and of the Open Replay flow that plays it back.
# They must carry a burned-in time: set `latency_burn_in: true` in the production's values in Open Live (or use
# the synthetic chain, `pnpm chain:create`). The Studio reads the time and shows the delays.
OPEN_REPLAY_LATENCY_LIVE_WHEP_URL=
OPEN_REPLAY_LATENCY_REPLAY_WHEP_URL=

# How far behind the newest segment "live" plays, in ms (default 1500). Lower is less delay, and less room for a
# late segment: with 1 s segments, 1000 was clean and 500 stuttered; with 500 ms segments, 800 was clean and 600
# stuttered. See the README.
OPEN_REPLAY_LIVE_MARGIN_MS=

# The Open Replay API (repos/open-replay). It reads the TAMS store and drives Strom; the studio holds no keys.
OPEN_REPLAY_API_URL=http://localhost:3100
